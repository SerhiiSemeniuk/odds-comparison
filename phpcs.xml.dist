<?xml version="1.0"?>
<ruleset name="Odds Comparison"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

    <description>
        WordPress Coding Standards for the parts that matter for correctness and safety:
        security (escaping, nonces, input), database queries, i18n, deprecated APIs, prefixes.
        Code layout and naming follow PSR-12 (namespaces, camelCase, short arrays, spaces),
        so WPCS's purely stylistic sniffs (tabs, array(), snake_case, Yoda) are not enabled.
    </description>

    <file>odds-comparison.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.5"/>

    <!-- Security: output escaping, nonces, input validation. -->
    <rule ref="WordPress.Security">
        <!--
            Exception messages are plain text, never HTML: REST answers are JSON, the admin prints
            them through esc_html() and the block script through textContent. Escaping them at the
            throw site would double-escape them everywhere else.
        -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <!-- Database: prepared statements, discouraged direct calls. -->
    <rule ref="WordPress.DB">
        <!-- The plugin owns its tables; direct queries are the point of a custom table. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery"/>
    </rule>

    <!-- WordPress APIs: i18n, deprecated functions, enqueuing, cron, etc. -->
    <rule ref="WordPress.WP">
        <exclude name="WordPress.WP.AlternativeFunctions"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="odds-comparison"/>
            </property>
        </properties>
    </rule>

    <!-- PHP hazards: extract(), silenced errors, discouraged functions, strict in_array. -->
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.DontExtract"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
    <rule ref="WordPress.PHP.StrictInArray"/>
    <rule ref="WordPress.PHP.TypeCasts"/>

    <!-- Everything global must carry the plugin's prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="oddscmp"/>
                <element value="odds_comparison"/>
                <element value="OddsComparison"/>
                <element value="ODDSCMP"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.CodeAnalysis"/>

    <!-- Hook names are the plugin's public API and use its prefix. -->
    <rule ref="WordPress.NamingConventions.ValidHookName"/>

    <!-- Templates are included inside a method scope, so their variables are not globals. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/templates/*</exclude-pattern>
    </rule>
</ruleset>
